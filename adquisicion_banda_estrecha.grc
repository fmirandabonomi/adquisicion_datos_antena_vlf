options:
  parameters:
    author: Fernando
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: adquisicion_banda_estrecha
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "Adquisici\xF3n de banda estrecha, dos sinton\xEDas independientes (1,56\
      \ kbps)"
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [296, 40.0]
    rotation: 0
    state: enabled

blocks:
- name: archivo_salida
  id: variable
  parameters:
    comment: ''
    value: dt.datetime.utcnow().strftime("banda_estrecha-%Y-%m-%dt%H%M%S.wav")
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2424, 772.0]
    rotation: 0
    state: true
- name: bw
  id: variable
  parameters:
    comment: ''
    value: '20'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1880, 564.0]
    rotation: 0
    state: true
- name: decim
  id: variable
  parameters:
    comment: ''
    value: int((samp_rate/2)/(bw*(1+fraccion_corte)/2))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2104, 564.0]
    rotation: 0
    state: true
- name: filename
  id: variable
  parameters:
    comment: ''
    value: f"captura_{datetime.today().strftime('%Y-%m-%d-t-%H-%M-%S')}"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [784, 64.0]
    rotation: 0
    state: enabled
- name: fraccion_corte
  id: variable
  parameters:
    comment: ''
    value: '.25'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1960, 564.0]
    rotation: 0
    state: true
- name: fsint
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 5,0,1,12
    label: "Sinton\xEDa"
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: 10e3
    step: '100'
    stop: 88.2e3
    value: '24000'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [504, 484.0]
    rotation: 0
    state: disabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 72e6/(6*(56+12))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [544, 64.0]
    rotation: 0
    state: enabled
- name: samp_rate_salida
  id: variable
  parameters:
    comment: ''
    value: samp_rate/decim
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2296, 772.0]
    rotation: 0
    state: true
- name: wide_fft_width
  id: variable
  parameters:
    comment: ''
    value: '8192'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1624, 556.0]
    rotation: 0
    state: true
