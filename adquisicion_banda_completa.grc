options:
  parameters:
    author: Fernando
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: adquisicion_banda_completa
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "Adquisici\xF3n de banda completa (5,39 Mbps)"
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [296, 40.0]
    rotation: 0
    state: enabled

blocks:
- name: archivo_salida
  id: variable
  parameters:
    comment: ''
    value: dt.datetime.utcnow().strftime("banda_completa-%Y-%m-%dt%H%M%S.wav")
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1880, 764.0]
    rotation: 0
    state: true
- name: filename
  id: variable
  parameters:
    comment: ''
    value: f"captura_{datetime.today().strftime('%Y-%m-%d-t-%H-%M-%S')}"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [784, 64.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 72e6/(6*(56+12))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [544, 64.0]
    rotation: 0
    state: enabled
